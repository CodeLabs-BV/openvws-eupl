{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.organisation.department_landing_page_edit' | trans({'name': department.name}) %}

{% block body %}
<div class="bhr-container bhr-container--sm">
    <h1 class="bhr-title mb-10">{{ page_title }}</h1>

    <div class="bhr-card">
        <twig:Admin:Tabs
            buttonTitles="{{ ['Titel en omschrijving', 'Logo'] }}"
            name="landingspagina"
            title="Dit is een titel"
        >
            <twig:Tab:Content
                tabNumber="1"
                tabsName="landingspagina"
                isHidden="{{ false }}"
            >
                <div class="pt-4">
                    <p class="bhr-form-help mb-2">{{ 'admin.department.landingpage_help' | trans }}</p>
                    <button type="button" class="bhr-btn-bordered-primary mb-4" data-ai-write
                            data-ai-token="{{ csrf_token('ai_generate') }}"
                            data-ai-context="titel en omschrijving van de landingspagina van bestuursorgaan {{ department.name }}">
                        {{ 'admin.ai.write' | trans }}
                    </button>
                    {{ form(form) }}
                </div>
            </twig:Tab:Content>

            <twig:Tab:Content
                tabNumber="2"
                tabsName="landingspagina"
                isHidden="{{ true }}"
            >
                <div class="pt-4">
                    <div {{ vue_component('GenericController', {
                        componentName: 'DepartmentLogoManager',

                        departmentId: department.departmentId,
                        deleteEndpoint: department.deleteLogoEndpoint,
                        logoEndpoint: department.logoEndpoint,
                        uploadEndpoint: department.uploadLogoEndpoint,
                        hasLogo: department.hasLogo,
                    }) }}>
                        <div class="min-h-14"></div>
                    </div>
                </div>
            </twig:Tab:Content>
        </twig:Admin:Tabs>
    </div>
</div>
{% include 'admin/departments/_ai_write.html.twig' %}
{% endblock %}
