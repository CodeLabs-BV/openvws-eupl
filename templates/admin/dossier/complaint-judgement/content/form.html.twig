{{ form_start(form) }}
    {{ form_row(form.summary) }}
    <button type="button" class="bhr-btn-bordered-primary mb-4" data-ai-write
            data-ai-token="{{ csrf_token('ai_generate') }}"
            data-ai-context="samenvatting van een Woo-dossier">
        {{ 'admin.ai.write_summary' | trans }}
    </button>

    <twig:Admin:Publication:ManageNoticeNotPublic
        canDelete="{{ hasNoticeNotPublic }}"
        endpoint="{{ '/balie/api/dossiers/' ~ dossier.id ~ '/notice-not-public' }}"
        formField="{{ form.noticeNotPublic }}"
        grounds="{{ grounds }}"
        hasMainDocument="{{ dossier.mainDocument is not null }}"
    />

    <twig:Admin:Publication:ManageDocument
        canDelete="{{ canDeleteDocument }}"
        documentType="{{ 'admin.dossiers.complaint-judgement.document' | trans }}"
        documentTypes="{{ documentTypes }}"
        endpoint="{{ '/balie/api/dossiers/' ~ dossier.id ~ '/complaint-judgement-document' }}"
        fileLimits="{{ documentFileLimits | default([])}}"
        formField="{{ form.document }}"
        grounds="{{ grounds }}"
        hasNoticeNotPublic="{{ hasNoticeNotPublic }}"
        helpText="{{ 'admin.dossiers.complaint-judgement.form.content.document_help' | trans }}"
        languages="{{ documentLanguages }}"
        title="{{ 'admin.dossiers.complaint-judgement.form.content.document_label' | trans }}"
        dossierId="{{ dossier.id }}"
    />

{{ form_end(form) }}
