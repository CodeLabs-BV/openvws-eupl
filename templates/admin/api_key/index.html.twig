{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.global.label.api_management' | trans %}

{% block body %}
    <div class="bhr-container">
        <style nonce="{{ csp_nonce() }}">
            .api-ai-card {
                background: #ffffff;
                border: 1px solid #d5d7dd;
                border-radius: 8px;
                box-shadow: 0 1px 4px rgb(15 23 42 / 0.08);
                padding: 1.5rem;
            }
            .api-ai-stat-card {
                background: #ffffff;
                border: 1px solid #e2e5ea;
                border-radius: 8px;
                box-shadow: 0 1px 3px rgb(15 23 42 / 0.06);
                padding: 1rem;
            }
        </style>

        <script nonce="{{ csp_nonce() }}">
            document.addEventListener('DOMContentLoaded', function () {
                var toggle = document.querySelector('[data-action="toggle-create"]');
                if (toggle) {
                    toggle.addEventListener('click', function () {
                        document.getElementById('create-key-form').classList.toggle('hidden');
                    });
                }
                var cancel = document.querySelector('[data-action="cancel-create"]');
                if (cancel) {
                    cancel.addEventListener('click', function () {
                        document.getElementById('create-key-form').classList.add('hidden');
                    });
                }
                document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!window.confirm(form.getAttribute('data-confirm'))) {
                            event.preventDefault();
                        }
                    });
                });
            });
        </script>

        <twig:Admin:LeftAndRight>
            <div>
                <h1 class="bhr-title">{{ page_title }}</h1>
                <p class="bhr-form-help">{{ 'admin.ai.page_intro' | trans }}</p>
            </div>

            <twig:block name="right">
                <a class="bhr-btn-filled-primary" href="{{ path('app_admin_api_docs') }}" target="_blank" rel="noopener" data-e2e-name="open-api-docs">
                    {{ 'admin.api_key.open_docs' | trans }}
                </a>
            </twig:block>
        </twig:Admin:LeftAndRight>

        {% set tabButtonTitles = ['admin.ai.section_tokens' | trans, 'admin.ai.section_model' | trans, 'admin.ai.section_usage' | trans, 'admin.ai.section_tooi' | trans] %}
        {% set tabsName = 'api-ai' %}

        <twig:Admin:Tabs
            buttonTitles="{{ tabButtonTitles }}"
            name="{{ tabsName }}"
            title="{{ page_title }}"
        >
            {# --- Tab 1: Token-beheer --- #}
            <twig:Tab:Content tabNumber="1" tabsName="{{ tabsName }}" isHidden="false">
                <div class="api-ai-card">
                    {% include 'admin/shared/flash-messages.html.twig' %}

                    {% if createdToken is not null %}
                        <div class="mb-6" data-e2e-name="api-key-created">
                            <twig:Admin:Alert type="info">
                                <strong>{{ 'admin.api_key.token_created' | trans }}</strong>
                                <p class="mt-2 break-all font-mono">{{ createdToken.key }}</p>
                                <p class="mt-2">{{ 'admin.api_key.token_once_notice' | trans }}</p>
                            </twig:Admin:Alert>
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <h2 class="bhr-h2 mb-0">{{ 'admin.api_key.list_title' | trans }}</h2>
                        <button type="button" class="bhr-btn-filled-primary" data-e2e-name="toggle-create-api-key"
                                data-action="toggle-create">
                            {{ 'admin.api_key.create' | trans }}
                        </button>
                    </div>

                    {% if apiKeys | length > 0 %}
                        <table class="bhr-table" data-e2e-name="api-keys-table">
                            <thead>
                                <tr>
                                    <th>{{ 'admin.api_key.name' | trans }}</th>
                                    <th>{{ 'admin.api_key.key' | trans }}</th>
                                    <th>{{ 'admin.api_key.created' | trans }}</th>
                                    <th>{{ 'admin.api_key.expires' | trans }}</th>
                                    <th>{{ 'admin.api_key.last_used' | trans }}</th>
                                    <th>{{ 'admin.api_key.status' | trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for apiKey in apiKeys %}
                                    <tr>
                                        <td>{{ apiKey.name }}</td>
                                        <td><code>{{ apiKey.keyPrefix }}…</code></td>
                                        <td>{{ apiKey.createdAt | format_datetime('short', 'short', locale='nl') }}</td>
                                        <td>{{ apiKey.expiresAt ? apiKey.expiresAt | format_datetime('short', 'short', locale='nl') : '—' }}</td>
                                        <td>{{ apiKey.lastUsedAt ? apiKey.lastUsedAt | format_datetime('short', 'short', locale='nl') : '—' }}</td>
                                        <td>
                                            {% if apiKey.enabled %}
                                                <span class="bhr-status bhr-status--success">{{ 'admin.api_key.status_active' | trans }}</span>
                                            {% else %}
                                                <span class="bhr-status bhr-status--muted">{{ 'admin.api_key.status_revoked' | trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-right">
                                            {% if apiKey.enabled %}
                                                <form method="post" action="{{ path('app_admin_api_keys_revoke', { id: apiKey.id.toRfc4122 }) }}" data-confirm="{{ 'admin.api_key.revoke_confirm' | trans }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">
                                                    <button type="submit" class="bhr-button bhr-button--danger">{{ 'admin.api_key.revoke' | trans }}</button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>{{ 'admin.api_key.none' | trans }}</p>
                    {% endif %}

                    <div id="create-key-form" class="hidden mt-6 border-t border-gray-200 pt-6">
                        <h3 class="bhr-h2">{{ 'admin.api_key.create_title' | trans }}</h3>

                        <form method="post" action="{{ path('app_admin_api_keys_create') }}" data-e2e-name="create-api-key">
                            <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div class="bhr-form-group">
                                    <label class="bhr-label" for="api_key_name">{{ 'admin.api_key.name' | trans }}</label>
                                    <input class="bhr-input" id="api_key_name" name="name" type="text" maxlength="255" required>
                                </div>

                                <div class="bhr-form-group">
                                    <label class="bhr-label" for="api_key_expires">{{ 'admin.api_key.expires_optional' | trans }}</label>
                                    <input class="bhr-input" id="api_key_expires" name="expires_at" type="datetime-local">
                                    <p class="bhr-form-help">{{ 'admin.api_key.expires_help' | trans }}</p>
                                </div>
                            </div>

                            <div class="flex gap-2">
                                <button type="submit" class="bhr-btn-filled-primary">{{ 'admin.api_key.create' | trans }}</button>
                                <button type="button" class="bhr-button" data-action="cancel-create">{{ 'admin.ai.cancel' | trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </twig:Tab:Content>

            {# --- Tab 2: AI-model en agent --- #}
            <twig:Tab:Content tabNumber="2" tabsName="{{ tabsName }}" isHidden="true">
                <div class="api-ai-card">
                    <h2 class="bhr-h2">{{ 'admin.ai.model_title' | trans }}</h2>
                    <p class="bhr-form-help mb-4">{{ 'admin.ai.model_help' | trans }}</p>

                    <form method="post" action="{{ path('app_admin_ai_model_save') }}" data-e2e-name="ai-model-form" class="max-w-md">
                        <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">

                        <div class="bhr-form-group">
                            <label class="bhr-label" for="ai_model">{{ 'admin.ai.model_label' | trans }}</label>
                            <select class="bhr-input" id="ai_model" name="model">
                                {% for model in availableModels %}
                                    <option value="{{ model }}" {% if model == activeModel %}selected{% endif %}>{{ model }}</option>
                                {% endfor %}
                            </select>
                            <p class="bhr-form-help">{{ 'admin.ai.model_current' | trans({'model': activeModel}) }}</p>
                        </div>

                        <button type="submit" class="bhr-btn-filled-primary">{{ 'admin.ai.model_save' | trans }}</button>
                    </form>
                </div>
            </twig:Tab:Content>

            {# --- Tab 3: Verbruik (OpenRouter-stijl) --- #}
            <twig:Tab:Content tabNumber="3" tabsName="{{ tabsName }}" isHidden="true">
                <div class="api-ai-card">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <div>
                            <h2 class="bhr-h2 mb-0">{{ 'admin.ai.usage_title' | trans }}</h2>
                            <p class="bhr-form-help mb-0">{{ 'admin.ai.usage_help' | trans }}</p>
                        </div>
                        {% if usage.budget is not null %}
                            <twig:Admin:Alert type="info">
                                {{ 'admin.ai.usage_budget_left' | trans({'left': (usage.budget - usage.totalSpend) | number_format(2, ',', '.')}) }}
                            </twig:Admin:Alert>
                        {% endif %}
                    </div>

                    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_tokens' | trans }}</p>
                            <p class="bhr-h2">{{ usage.totalTokens | number_format(0, ',', '.') }}</p>
                        </div>
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_requests' | trans }}</p>
                            <p class="bhr-h2">{{ usage.requests | number_format(0, ',', '.') }}</p>
                        </div>
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_spend' | trans }}</p>
                            <p class="bhr-h2">€ {{ usage.totalSpend | number_format(4, ',', '.') }}</p>
                        </div>
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_budget' | trans }}</p>
                            <p class="bhr-h2">{{ usage.budget is not null ? '€ ' ~ usage.budget | number_format(2, ',', '.') : '—' }}</p>
                        </div>
                    </div>

                    {% set tokenValues = usage.byDay | map(d => d.totalTokens) %}
                    {% set maxTokens = max(tokenValues) > 0 ? max(tokenValues) : 1 %}
                    <div class="mb-6">
                        <h3 class="bhr-h2">{{ 'admin.ai.usage_week' | trans }}</h3>
                        <div class="border border-gray-200 rounded-lg p-4 bg-gray-50">
                            <svg viewBox="0 0 700 140" role="img" aria-label="{{ 'admin.ai.usage_week_chart' | trans }}" class="w-full h-auto">
                                {% for day in usage.byDay %}
                                    {% set barH = (day.totalTokens / maxTokens * 100) | round %}
                                    {% if barH < 2 %}{% set barH = 2 %}{% endif %}
                                    {% set x = loop.index0 * 92 + 28 %}
                                    {% set y = 118 - barH %}
                                    <rect x="{{ x }}" y="{{ y }}" width="48" height="{{ barH }}" rx="4" fill="#1d4ed8" />
                                    <text x="{{ x + 24 }}" y="132" text-anchor="middle" font-size="10" fill="#374151">{{ day.date | date('D') }}</text>
                                    <text x="{{ x + 24 }}" y="{{ y - 4 }}" text-anchor="middle" font-size="9" fill="#6b7280">{{ day.totalTokens }}</text>
                                {% endfor %}
                            </svg>
                        </div>
                    </div>

                    <div class="mb-6">
                        <h3 class="bhr-h2">{{ 'admin.ai.usage_by_model' | trans }}</h3>
                        {% if usage.byModel | length > 0 %}
                            <table class="bhr-table" data-e2e-name="ai-usage-by-model">
                                <thead>
                                    <tr>
                                        <th>{{ 'admin.ai.usage_model' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_requests' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_prompt' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_completion' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_tokens' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_spend' | trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in usage.byModel %}
                                        <tr>
                                            <td><code>{{ row.model }}</code></td>
                                            <td class="text-right">{{ row.requests | number_format(0, ',', '.') }}</td>
                                            <td class="text-right">{{ row.promptTokens | number_format(0, ',', '.') }}</td>
                                            <td class="text-right">{{ row.completionTokens | number_format(0, ',', '.') }}</td>
                                            <td class="text-right"><strong>{{ row.totalTokens | number_format(0, ',', '.') }}</strong></td>
                                            <td class="text-right">€ {{ row.spend | number_format(4, ',', '.') }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% else %}
                            <p>{{ 'admin.ai.usage_none' | trans }}</p>
                        {% endif %}
                    </div>

                    {% if usage.logs | length > 0 %}
                        <div>
                            <h3 class="bhr-h2">{{ 'admin.ai.usage_recent' | trans }}</h3>
                            <table class="bhr-table" data-e2e-name="ai-usage-table">
                                <thead>
                                    <tr>
                                        <th>{{ 'admin.ai.usage_model' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_tokens' | trans }}</th>
                                        <th class="text-right">{{ 'admin.ai.usage_spend' | trans }}</th>
                                        <th>{{ 'admin.ai.usage_status' | trans }}</th>
                                        <th>{{ 'admin.ai.usage_at' | trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for log in usage.logs | slice(0, 25) %}
                                        <tr>
                                            <td><code>{{ log.model }}</code></td>
                                            <td class="text-right">{{ log.tokens | number_format(0, ',', '.') }}</td>
                                            <td class="text-right">€ {{ log.spend | number_format(4, ',', '.') }}</td>
                                            <td>{{ log.status }}</td>
                                            <td>{{ log.at }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}
                </div>
            </twig:Tab:Content>

            {# --- Tab 4: TOOI --- #}
            <twig:Tab:Content tabNumber="4" tabsName="{{ tabsName }}" isHidden="true">
                <div class="api-ai-card">
                    <h2 class="bhr-h2">{{ 'admin.tooi.title' | trans }}</h2>
                    <p class="bhr-form-help mb-4">{{ 'admin.tooi.help' | trans }}</p>

                    <form method="get" action="{{ path('app_admin_api_management') }}" class="mb-6 max-w-xl" data-e2e-name="tooi-search">
                        <div class="bhr-form-group">
                            <label class="bhr-label" for="tooi_type">{{ 'admin.tooi.type_label' | trans }}</label>
                            <select class="bhr-input" id="tooi_type" name="tooi_type">
                                <option value="categorieen" {% if tooiType != 'organisaties' %}selected{% endif %}>{{ 'admin.tooi.type_categories' | trans }}</option>
                                <option value="organisaties" {% if tooiType == 'organisaties' %}selected{% endif %}>{{ 'admin.tooi.type_organisations' | trans }}</option>
                            </select>
                        </div>
                        <div class="flex gap-2 items-end">
                            <div class="bhr-form-group grow">
                                <label class="bhr-label" for="tooi_q">{{ 'admin.tooi.search_label' | trans }}</label>
                                <input class="bhr-input" id="tooi_q" name="tooi_q" type="text" value="{{ tooiQuery }}" placeholder="{{ tooiType == 'organisaties' ? 'bijv. gemeente Utrecht' : 'bijv. jaarverslagen' }}">
                            </div>
                            <button type="submit" class="bhr-btn-filled-primary">{{ 'admin.tooi.search_button' | trans }}</button>
                        </div>
                        <p class="bhr-form-help">{{ 'admin.tooi.source_note' | trans }}</p>
                    </form>

                    {% if tooiQuery is not empty %}
                        <p class="bhr-form-help mb-2">{{ 'admin.tooi.results' | trans }} <strong>{{ tooiResults | length }}</strong></p>
                    {% endif %}

                    {% if tooiResults | length > 0 %}
                        <table class="bhr-table" data-e2e-name="tooi-results">
                            <thead>
                                <tr>
                                    <th>{{ 'admin.subject.tooi_label' | trans }}</th>
                                    <th>{{ 'admin.subject.tooi_uri' | trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in tooiResults %}
                                    <tr>
                                        <td>{{ item.label }}</td>
                                        <td><code class="break-all">{{ item.uri }}</code></td>
                                        <td class="text-right">
                                            <twig:Admin:CopyToClipboardLayout copy="{{ item.uri }}" />
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        {% if tooiQuery is not empty %}
                            <p>{{ 'admin.tooi.none' | trans }}</p>
                        {% endif %}
                    {% endif %}
                </div>
            </twig:Tab:Content>

        </twig:Admin:Tabs>
    </div>
{% endblock %}