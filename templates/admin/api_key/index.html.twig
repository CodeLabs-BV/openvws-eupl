{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.global.label.api_management' | trans %}

{% block body %}
    <div class="bhr-container">
        <style nonce="{{ csp_nonce() }}">
            .api-ai-card {
                background: #ffffff;
                border: 1px solid #d5d7dd;
                border-radius: 8px;
                box-shadow: 0 1px 4px rgb(15 23 42 / 0.08);
                padding: 1.5rem;
            }
            .api-ai-stat-card {
                background: #ffffff;
                border: 1px solid #e2e5ea;
                border-radius: 8px;
                box-shadow: 0 1px 3px rgb(15 23 42 / 0.06);
                padding: 1rem;
            }
        </style>

        <script nonce="{{ csp_nonce() }}">
            document.addEventListener('DOMContentLoaded', function () {
                var toggle = document.querySelector('[data-action="toggle-create"]');
                if (toggle) {
                    toggle.addEventListener('click', function () {
                        document.getElementById('create-key-form').classList.toggle('hidden');
                    });
                }
                var cancel = document.querySelector('[data-action="cancel-create"]');
                if (cancel) {
                    cancel.addEventListener('click', function () {
                        document.getElementById('create-key-form').classList.add('hidden');
                    });
                }
                document.querySelectorAll('form[data-confirm]').forEach(function (form) {
                    form.addEventListener('submit', function (event) {
                        if (!window.confirm(form.getAttribute('data-confirm'))) {
                            event.preventDefault();
                        }
                    });
                });
            });
        </script>

        <twig:Admin:LeftAndRight>
            <div>
                <h1 class="bhr-title">{{ page_title }}</h1>
                <p class="bhr-form-help">{{ 'admin.ai.page_intro' | trans }}</p>
            </div>

            <twig:block name="right">
                <a class="bhr-btn-filled-primary" href="{{ path('app_admin_api_docs') }}" target="_blank" rel="noopener" data-e2e-name="open-api-docs">
                    {{ 'admin.api_key.open_docs' | trans }}
                </a>
            </twig:block>
        </twig:Admin:LeftAndRight>

        {% set tabButtonTitles = ['admin.ai.section_tokens' | trans, 'admin.ai.section_model' | trans, 'admin.ai.section_usage' | trans] %}
        {% set tabsName = 'api-ai' %}

        <twig:Admin:Tabs
            buttonTitles="{{ tabButtonTitles }}"
            name="{{ tabsName }}"
            title="{{ page_title }}"
        >
            {# --- Tab 1: Token-beheer --- #}
            <twig:Tab:Content tabNumber="1" tabsName="{{ tabsName }}" isHidden="false">
                <div class="api-ai-card">
                    {% include 'admin/shared/flash-messages.html.twig' %}

                    {% if createdToken is not null %}
                        <div class="mb-6" data-e2e-name="api-key-created">
                            <twig:Admin:Alert type="info">
                                <strong>{{ 'admin.api_key.token_created' | trans }}</strong>
                                <p class="mt-2 break-all font-mono">{{ createdToken.key }}</p>
                                <p class="mt-2">{{ 'admin.api_key.token_once_notice' | trans }}</p>
                            </twig:Admin:Alert>
                        </div>
                    {% endif %}

                    <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
                        <h2 class="bhr-h2 mb-0">{{ 'admin.api_key.list_title' | trans }}</h2>
                        <button type="button" class="bhr-btn-filled-primary" data-e2e-name="toggle-create-api-key"
                                data-action="toggle-create">
                            {{ 'admin.api_key.create' | trans }}
                        </button>
                    </div>

                    {% if apiKeys | length > 0 %}
                        <table class="bhr-table" data-e2e-name="api-keys-table">
                            <thead>
                                <tr>
                                    <th>{{ 'admin.api_key.name' | trans }}</th>
                                    <th>{{ 'admin.api_key.key' | trans }}</th>
                                    <th>{{ 'admin.api_key.created' | trans }}</th>
                                    <th>{{ 'admin.api_key.expires' | trans }}</th>
                                    <th>{{ 'admin.api_key.last_used' | trans }}</th>
                                    <th>{{ 'admin.api_key.status' | trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for apiKey in apiKeys %}
                                    <tr>
                                        <td>{{ apiKey.name }}</td>
                                        <td><code>{{ apiKey.keyPrefix }}…</code></td>
                                        <td>{{ apiKey.createdAt | format_datetime('short', 'short', locale='nl') }}</td>
                                        <td>{{ apiKey.expiresAt ? apiKey.expiresAt | format_datetime('short', 'short', locale='nl') : '—' }}</td>
                                        <td>{{ apiKey.lastUsedAt ? apiKey.lastUsedAt | format_datetime('short', 'short', locale='nl') : '—' }}</td>
                                        <td>
                                            {% if apiKey.enabled %}
                                                <span class="bhr-status bhr-status--success">{{ 'admin.api_key.status_active' | trans }}</span>
                                            {% else %}
                                                <span class="bhr-status bhr-status--muted">{{ 'admin.api_key.status_revoked' | trans }}</span>
                                            {% endif %}
                                        </td>
                                        <td class="text-right">
                                            {% if apiKey.enabled %}
                                                <form method="post" action="{{ path('app_admin_api_keys_revoke', { id: apiKey.id.toRfc4122 }) }}" data-confirm="{{ 'admin.api_key.revoke_confirm' | trans }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">
                                                    <button type="submit" class="bhr-button bhr-button--danger">{{ 'admin.api_key.revoke' | trans }}</button>
                                                </form>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>{{ 'admin.api_key.none' | trans }}</p>
                    {% endif %}

                    <div id="create-key-form" class="hidden mt-6 border-t border-gray-200 pt-6">
                        <h3 class="bhr-h2">{{ 'admin.api_key.create_title' | trans }}</h3>

                        <form method="post" action="{{ path('app_admin_api_keys_create') }}" data-e2e-name="create-api-key">
                            <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                                <div class="bhr-form-group">
                                    <label class="bhr-label" for="api_key_name">{{ 'admin.api_key.name' | trans }}</label>
                                    <input class="bhr-input" id="api_key_name" name="name" type="text" maxlength="255" required>
                                </div>

                                <div class="bhr-form-group">
                                    <label class="bhr-label" for="api_key_expires">{{ 'admin.api_key.expires_optional' | trans }}</label>
                                    <input class="bhr-input" id="api_key_expires" name="expires_at" type="datetime-local">
                                    <p class="bhr-form-help">{{ 'admin.api_key.expires_help' | trans }}</p>
                                </div>
                            </div>

                            <div class="flex gap-2">
                                <button type="submit" class="bhr-btn-filled-primary">{{ 'admin.api_key.create' | trans }}</button>
                                <button type="button" class="bhr-button" data-action="cancel-create">{{ 'admin.ai.cancel' | trans }}</button>
                            </div>
                        </form>
                    </div>
                </div>
            </twig:Tab:Content>

            {# --- Tab 2: AI-model en agent --- #}
            <twig:Tab:Content tabNumber="2" tabsName="{{ tabsName }}" isHidden="true">
                <div class="api-ai-card">
                    <h2 class="bhr-h2">{{ 'admin.ai.model_title' | trans }}</h2>
                    <p class="bhr-form-help mb-4">{{ 'admin.ai.model_help' | trans }}</p>

                    <form method="post" action="{{ path('app_admin_ai_model_save') }}" data-e2e-name="ai-model-form" class="max-w-md">
                        <input type="hidden" name="_token" value="{{ csrf_token('api_key') }}">

                        <div class="bhr-form-group">
                            <label class="bhr-label" for="ai_model">{{ 'admin.ai.model_label' | trans }}</label>
                            <select class="bhr-input" id="ai_model" name="model">
                                {% for model in availableModels %}
                                    <option value="{{ model }}" {% if model == activeModel %}selected{% endif %}>{{ model }}</option>
                                {% endfor %}
                            </select>
                            <p class="bhr-form-help">{{ 'admin.ai.model_current' | trans({'model': activeModel}) }}</p>
                        </div>

                        <button type="submit" class="bhr-btn-filled-primary">{{ 'admin.ai.model_save' | trans }}</button>
                    </form>
                </div>
            </twig:Tab:Content>

            {# --- Tab 3: Verbruik --- #}
            <twig:Tab:Content tabNumber="3" tabsName="{{ tabsName }}" isHidden="true">
                <div class="api-ai-card">
                    <h2 class="bhr-h2">{{ 'admin.ai.usage_title' | trans }}</h2>
                    <p class="bhr-form-help mb-4">{{ 'admin.ai.usage_help' | trans }}</p>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_tokens' | trans }}</p>
                            <p class="bhr-h2">{{ usage.totalTokens | number_format(0, ',', '.') }}</p>
                        </div>
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_spend' | trans }}</p>
                            <p class="bhr-h2">€ {{ usage.totalSpend | number_format(4, ',', '.') }}</p>
                        </div>
                        <div class="api-ai-stat-card">
                            <p class="bhr-label">{{ 'admin.ai.usage_budget' | trans }}</p>
                            <p class="bhr-h2">{{ usage.budget is not null ? '€ ' ~ usage.budget | number_format(2, ',', '.') : '—' }}</p>
                        </div>
                    </div>

                    {% if usage.logs | length > 0 %}
                        <table class="bhr-table" data-e2e-name="ai-usage-table">
                            <thead>
                                <tr>
                                    <th>{{ 'admin.ai.usage_model' | trans }}</th>
                                    <th>{{ 'admin.ai.usage_tokens' | trans }}</th>
                                    <th>{{ 'admin.ai.usage_spend' | trans }}</th>
                                    <th>{{ 'admin.ai.usage_status' | trans }}</th>
                                    <th>{{ 'admin.ai.usage_at' | trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for log in usage.logs | slice(0, 25) %}
                                    <tr>
                                        <td>{{ log.model }}</td>
                                        <td>{{ log.tokens | number_format(0, ',', '.') }}</td>
                                        <td>€ {{ log.spend | number_format(4, ',', '.') }}</td>
                                        <td>{{ log.status }}</td>
                                        <td>{{ log.at }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p>{{ 'admin.ai.usage_none' | trans }}</p>
                    {% endif %}
                </div>
            </twig:Tab:Content>
        </twig:Admin:Tabs>
    </div>
{% endblock %}