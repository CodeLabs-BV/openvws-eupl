{% extends 'admin/base.html.twig' %}

{% set page_title = 'admin.subject.edit' | trans({'name': subject.name}) %}

{% block body %}
<div class="bhr-container bhr-container--sm">
    <twig:Admin:LeftAndRight>
        <h1 class="bhr-title">{{ page_title }}</h1>

        <twig:block name="right">
            <a class="bhr-btn-bordered-primary whitespace-nowrap" href="{{ path('app_admin_subject_landing_page_edit', { id: subject.id }) }}" data-e2e-name="update-landing-page">{{ 'admin.department.update_landing_page' | trans }}</a>
        </twig:block>
    </twig:Admin:LeftAndRight>

    <div class="api-ai-card">
        {{ form_start(form) }}

        {{ form_row(form.name) }}

        {% if form.tooiLabel is defined %}
            {% include 'admin/departments/_tooi_picker.html.twig' with {
                'tooiFieldPrefix': 'subject',
                'tooiEndpoint': '/balie/tooi/zoek-cat',
                'tooiPlaceholder': 'bijv. jaarverslagen',
            } %}
            {{ form_row(form.tooiLabel) }}
            {{ form_row(form.tooiUri) }}
        {% endif %}

        <div class="flex gap-2">
            {{ form_widget(form.submit, { label: 'global.save' | trans }) }}
            <a class="bhr-btn-bordered-primary" href="{{ path('app_admin_subjects') }}">{{ 'admin.ai.cancel' | trans }}</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
{% endblock %}